# --- Supabase ---
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Cifrado de columnas *_enc (AES-256-GCM) ---
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=

# --- Cookie de sesion (SessionMiddleware: state/PKCE en transito OAuth + sesion de login) ---
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
COOKIE_SECRET=

# --- Cliente OAuth (realm "pre") SOLO para el login de esta app, no es el de Andes Air ---
AS_CLIENT_ID=
AS_CLIENT_SECRET=

# --- URL publica de esta app (se usa para construir redirect_uri y para "resource" en el login) ---
APP_BASE_URL=http://localhost:8000

# --- Origen del frontend (para CORS, con credentials porque la sesion viaja en cookie) ---
FRONTEND_URL=http://localhost:5173
